# Copy to .env.local (local) or configure the same keys in Vercel → Settings → Environment Variables.
# Never commit .env.local. Do not put the service_role key in the app or in NEXT_PUBLIC_*.

# ---------------------------------------------------------------------------
# Required for any Supabase-backed build
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# MVP demo / auth bypass (server + optional public mirror)
# ---------------------------------------------------------------------------
# When true (default if unset): fixed demo session, no login required for shell;
# organization id comes from DEMO_ORGANIZATION_ID / seed default — not from user_roles.
# Set to false when real auth + per-user org membership is enforced.
AUTH_GATING_TEMPORARILY_DISABLED=true
# Optional: same flag for client bundles if you ever read it in the browser (not required today).
# NEXT_PUBLIC_AUTH_GATING_TEMPORARILY_DISABLED=true

# UUID of the demo organization row (must match seed + anon RLS demo policies). Omit to use seed default.
# DEMO_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001
# NEXT_PUBLIC_DEMO_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001

# ---------------------------------------------------------------------------
# Debug panel (shell): visible when auth gating is disabled AND (NODE_ENV=development OR flag below)
# ---------------------------------------------------------------------------
# DEMO_DEBUG=true
# NEXT_PUBLIC_DEMO_DEBUG=true
