# Copy to .env.local and fill with values from your Supabase project (Settings → API).
# Use a dev project only — do not commit .env.local.

# Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anonymous (public) key — safe for browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
